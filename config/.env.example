PORT=3001
HOST_GRACE_MS=15000
# Comma separated origins when running frontend on a different origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional self-hosted song library. Keep these server-side and out of Git.
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=
NAVIDROME_ACCESS_CODE=
# Optional Audius API key. The public endpoint is tried without a key first.
AUDIUS_API_KEY=
# Number of trusted reverse-proxy hops in front of the Foyer server.
TRUST_PROXY_HOPS=0

# Vercel/shared storage (local startup uses SQLite unless explicitly enabled).
FOYER_REDIS=0
REDIS_URL=
FOYER_CLOUD_NAMESPACE=
# Set a stable random server-only value when enabling Navidrome on multiple instances.
FOYER_STREAM_SECRET=
# Host readiness wait (default 10000ms; bounded to 200–12000ms).
ROOM_SYNC_TIMEOUT_MS=10000
