{
  "name": "foyer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run build:extension && concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && node scripts/build-extension.mjs && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:browser": "node --max-old-space-size=128 --max-semi-space-size=1 --import tsx scripts/browser-benchmark.ts",
    "media": "node scripts/media.cjs",
    "media:audio": "node scripts/audio.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "test:extension": "npm run build:extension && node scripts/verify-extension.mjs",
    "test:extension:browser": "npm run build:extension && playwright test -c playwright.extension.config.ts",
    "providers:check": "node scripts/check-providers.mjs",
    "providers:youtube": "node scripts/check-youtube.mjs"
  },
  "dependencies": {
    "@vimeo/player": "^2.30.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "fuse.js": "^7.1.0",
    "helmet": "^8.3.0",
    "hls.js": "^1.7.3",
    "ioredis": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/chrome": "^0.3.5",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
